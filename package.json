{
    "name": "homify",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "commit": "git-cz",
        "prepare": "husky"
    },
    "config": {
        "commitizen": {
            "path": "node_modules/cz-git"
        }
    },
    "lint-staged": {
        "*.{md,json}": [
            "prettier --cache --write --no-error-on-unmatched-pattern"
        ],
        "*.{css,less}": [
            "stylelint --fix",
            "prettier --cache --write"
        ],
        "*.{js,jsx}": [
            "eslint --fix",
            "prettier --cache --write"
        ],
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --cache --parser=typescript --write"
        ]
    },
    "dependencies": {
        "@heyputer/puter.js": "2.2.10",
        "@vueuse/core": "^14.2.1",
        "lucide-vue-next": "0.575.0",
        "pinia": "3.0.4",
        "vue": "^3.5.25",
        "vue-router": "5.0.3"
    },
    "devDependencies": {
        "@commitlint/cli": "20.4.2",
        "@commitlint/config-conventional": "20.4.2",
        "@eslint/js": "10.0.1",
        "@tailwindcss/vite": "4.2.1",
        "@types/node": "^25.3.1",
        "@typescript-eslint/parser": "8.56.1",
        "@vitejs/plugin-vue": "6.0.4",
        "@vue/tsconfig": "0.8.1",
        "commitizen": "4.3.1",
        "commitlint": "20.4.2",
        "cspell": "9.7.0",
        "cz-git": "1.12.0",
        "eslint": "10.0.2",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "eslint-plugin-vue": "10.8.0",
        "globals": "17.3.0",
        "husky": "9.1.7",
        "lint-staged": "16.2.7",
        "prettier": "3.8.1",
        "stylelint": "17.4.0",
        "stylelint-config-standard": "40.0.0",
        "stylelint-config-standard-scss": "17.0.0",
        "stylelint-config-standard-vue": "1.0.0",
        "tailwindcss": "4.2.1",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vue-eslint-parser": "10.4.0",
        "vue-tsc": "^3.1.5"
    }
}
